generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ResourceCategory {
  STRESS
  SLEEP
  FOCUS
  BREATHING
  GROUNDING
  STUDY_PRESSURE
  GENERAL_WELLBEING
}

enum ResourceStatus {
  STARTED
  COMPLETED
}

enum RiskLevel {
  NORMAL
  DISTRESS
  HIGH_CONCERN
  CRISIS_SIGNAL
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String   @map("password_hash")
  preferredLanguage String   @default("en") @map("preferred_language")
  timezone          String   @default("Asia/Kolkata")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  profile          Profile?
  conversations    Conversation[]
  checkins         MoodCheckin[]
  resourceProgress ResourceProgress[]
  recommendations  Recommendation[]
  safetyEvents     SafetyEvent[]

  @@map("users")
}

model Profile {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  notificationPreferences Json     @default("{}") @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("New conversation")
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  language       String      @default("en")
  sources        Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MoodCheckin {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  mood         Int
  stressLevel  Int      @map("stress_level")
  energyLevel  Int      @map("energy_level")
  sleepQuality Int      @map("sleep_quality")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("mood_checkins")
}

model WellnessResource {
  id           String           @id @default(uuid())
  slug         String           @unique
  title        String
  description  String
  category     ResourceCategory
  duration     Int // minutes
  language     String           @default("en")
  instructions String[]
  source       String
  createdAt    DateTime         @default(now()) @map("created_at")

  progress        ResourceProgress[]
  recommendations Recommendation[]

  @@map("wellness_resources")
}

model ResourceProgress {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  resourceId  String         @map("resource_id")
  startedAt   DateTime       @default(now()) @map("started_at")
  completedAt DateTime?      @map("completed_at")
  status      ResourceStatus @default(STARTED)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource WellnessResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("resource_progress")
}

model Recommendation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  resourceId String   @map("resource_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource WellnessResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recommendations")
}

model SafetyEvent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  riskLevel   RiskLevel @map("risk_level")
  triggerType String    @map("trigger_type")
  actionShown String    @map("action_shown")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("safety_events")
}
