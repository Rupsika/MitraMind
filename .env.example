# Copy to .env and fill in. Never commit .env.

NODE_ENV=development

# --- Backend (Node/Express) ---
DATABASE_URL=postgresql://mitramind:change-me@localhost:5432/mitramind
# 32+ random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
AI_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# --- AI service (FastAPI) ---
# Google Gemini key (GEMINI_API_KEY is accepted as an alias)
GOOGLE_API_KEY=
# Sarvam AI key, needed for Hindi/Telugu/Tamil voice input and output
SARVAM_API_KEY=
# Optional: OpenAI backend instead of Gemini (set LLM_PROVIDER=openai)
LLM_PROVIDER=google
OPENAI_API_KEY=
# Protects POST /ai/admin/reindex (used by the worker). Leave empty to disable that endpoint.
INTERNAL_API_TOKEN=

# --- docker compose only ---
POSTGRES_PASSWORD=
