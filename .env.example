# API Keys for MitraMind Multilingual Chatbot

# Google Gemini API Key (used for LLM and embeddings by default)
# Get one from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (used for Hindi/Tamil/Telugu Voice Input/Output)
# Get one from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# (Optional) OpenAI API Key (if you wish to swap backends in config.py)
OPENAI_API_KEY=your_openai_api_key_here
